{
  "name": "frameforge",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node backend/index.mjs",
    "test": "node --test",
    "bench": "node scripts/bench-store.mjs",
    "start": "npm run build && node backend/index.mjs",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && npm run sharp:mac:both && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:signed": "npm run build && npm run sharp:mac:both && electron-builder --mac --publish never -c.mac.notarize.teamId=$APPLE_TEAM_ID",
    "dist:mac:ci": "npm run build && npm run sharp:mac:both && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:upload": "node scripts/release-upload.mjs",
    "landing:build": "vite build --config landingpage/vite.island.config.mjs",
    "landing:sync": "node landingpage/tools/sync-demo.mjs",
    "sharp:mac:both": "npm i --no-save --force @img/sharp-darwin-x64@0.35.3 @img/sharp-libvips-darwin-x64@1.3.2 @img/sharp-darwin-arm64@0.35.3 @img/sharp-libvips-darwin-arm64@1.3.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.frameforge.studio",
    "productName": "FrameForge",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "files": [
      "desktop/**",
      "backend/**",
      "shared/**",
      "dist/**",
      "frontend/modelCatalog.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-04eb7fb87e564f54b1ffd045b6f5ddfb.r2.dev",
        "channel": "latest"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FrameForge uses the microphone for voice dictation."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    }
  }
}
