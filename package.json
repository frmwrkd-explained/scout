{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node backend/index.mjs",
    "test": "node --test",
    "bench": "node scripts/bench-store.mjs",
    "demonstrate": "node scripts/demonstrate.mjs",
    "hub:push": "node scripts/hub-push.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "npm run build && node backend/index.mjs",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:signed": "npm run build && electron-builder --mac --publish never -c.mac.notarize.teamId=$APPLE_TEAM_ID",
    "dist:mac:ci": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:upload": "node scripts/release-upload.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-drag-handle": "3.31.3",
    "@tiptap/extension-drag-handle-react": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.scout.app",
    "productName": "Scout",
    "asar": true,
    "files": [
      "desktop/**",
      "backend/**",
      "shared/**",
      "skills/**",
      "scripts/**",
      "dist/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Scout uses the microphone for voice dictation."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
