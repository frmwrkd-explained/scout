# Scout credentials — copy to .env and fill in.
#   cp .env.example .env
#
# Loaded by backend/env.mjs at startup (zero-dependency; a missing .env is fine).
# .env is git-ignored. Never commit real keys.
#
# Precedence, highest first:
#   1. a real shell export        (GROQ_API_KEY=... npm run server)
#   2. this file                  (.env)
#   3. workspace/settings.md      (written by the Settings UI)

# ── the assistants ──────────────────────────────────────────────────────────
# Scout's assistants are CLI coding agents. Any CLI that accepts `-p <prompt>`
# and prints the answer works: claude, codex, gemini. They carry their own
# auth, so there is no key for them here — set the command in Settings.

# ── distillation (optional) ─────────────────────────────────────────────────
# https://console.groq.com/keys — starts with gsk_
# One cheap JSON call at session end turns a transcript into durable learnings
# (backend/distill.mjs, docs/03_MEMORY.md). Unset means no learnings are
# distilled; nothing else changes and nothing fails.
GROQ_API_KEY=

# ── bug reports (optional) ──────────────────────────────────────────────────
# Where in-app bug reports are sent. NOT a credential — it is the public URL of
# the deployment that collects them.
#
# Leave it unset and the feature still works end to end: the panel captures,
# redacts and shows you the payload, then writes the report to
# workspace/feedback/outbox/ instead of transmitting. Nothing is silently
# dropped, and nothing is ever sent anywhere else.
SCOUT_FEEDBACK_URL=

# ── licensing (optional) ────────────────────────────────────────────────────
# Scout has no licence server of its own yet. Unset means every check reports
# "no verdict" and enforcement is governed by isEnforced() alone.
SCOUT_LICENCE_API=
