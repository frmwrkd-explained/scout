# FrameForge provider credentials — copy to .env and fill in.
#   cp .env.example .env
#
# Loaded by backend/env.mjs at startup (zero-dependency; a missing .env is fine).
# .env is git-ignored. Never commit real keys.
#
# Precedence, highest first:
#   1. a real shell export        (FAL_KEY=... npm run server)
#   2. this file                  (.env)
#   3. workspace/settings.md      (written by the Settings UI)
#
# Keys set here win over the Settings UI, and the UI still shows CONNECTED
# because readiness comes from the resolver functions, not from settings.md.

# https://fal.ai/dashboard/keys — format is "id:secret"
FAL_KEY=

# https://console.groq.com/keys — starts with gsk_
GROQ_API_KEY=

# https://kie.ai — single bearer token
KIE_API_KEY=

# ── beta feedback (optional) ──────────────────────────────────────────────
# Where in-app bug reports are sent. This is NOT a credential — it is the
# public Convex .site URL of the deployment that collects them, the same one
# the landing page uses (landingpage/backend/README.md).
#
# Leave it unset and the feature still works end to end: the panel captures,
# redacts and shows you the payload, then writes the report to
# workspace/feedback/outbox/ instead of transmitting. Nothing is silently
# dropped, and nothing is ever sent anywhere else.
#
# See docs/specs/beta-feedback/spec.md
FRFG_FEEDBACK_URL=
